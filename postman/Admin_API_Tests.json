{
  "info": {
    "name": "GameZone Admin API",
    "description": "Postman collection for testing admin-related features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Register Admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Admin User\",\n    \"email\": \"admin@test.com\",\n    \"password\": \"admin123\",\n    \"confirmPassword\": \"admin123\",\n    \"role\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "    pm.collectionVariables.set('userId', pm.response.json().data._id);",
              "}",
              "pm.test('Status code is 201', function() {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has success: true', function() {",
              "    pm.expect(pm.response.json().success).to.eq(true);",
              "});",
              "pm.test('User has admin role', function() {",
              "    pm.expect(pm.response.json().data.role).to.eq('admin');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"admin@test.com\",\n    \"password\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('adminToken', pm.response.json().token);",
              "}",
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has token', function() {",
              "    pm.expect(pm.response.json()).to.have.property('token');",
              "});",
              "pm.test('Login successful message', function() {",
              "    pm.expect(pm.response.json().message).to.eq('Login successful');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Create User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/admin/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Test User\",\n    \"email\": \"testuser@test.com\",\n    \"password\": \"test123\",\n    \"confirmPassword\": \"test123\",\n    \"phone\": \"1234567890\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('userId', pm.response.json().data._id);",
              "}",
              "pm.test('Status code is 201', function() {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('User created successfully', function() {",
              "    pm.expect(pm.response.json().success).to.eq(true);",
              "});",
              "pm.test('Response has user data', function() {",
              "    pm.expect(pm.response.json().data).to.have.property('email');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Get All Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/users",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has users array', function() {",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});",
              "pm.test('Response has success: true', function() {",
              "    pm.expect(pm.response.json().success).to.eq(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Get User By ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/users/{{userId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has user data', function() {",
              "    pm.expect(pm.response.json().data).to.have.property('email');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Update User",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/admin/users/{{userId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Updated User Name\",\n    \"phone\": \"9876543210\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('User updated successfully', function() {",
              "    pm.expect(pm.response.json().success).to.eq(true);",
              "});",
              "pm.test('Name was updated', function() {",
              "    pm.expect(pm.response.json().data.fullName).to.eq('Updated User Name');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Delete User",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/admin/users/{{userId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('User deleted successfully', function() {",
              "    pm.expect(pm.response.json().success).to.eq(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Register Regular User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Regular User\",\n    \"email\": \"user@test.com\",\n    \"password\": \"user123\",\n    \"confirmPassword\": \"user123\",\n    \"role\": \"user\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function() {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('User has user role', function() {",
              "    pm.expect(pm.response.json().data.role).to.eq('user');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Get Profile (WhoAmI)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/whoami",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has user data', function() {",
              "    pm.expect(pm.response.json().data).to.have.property('email');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
